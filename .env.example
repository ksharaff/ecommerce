# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Never put a real secret in here.
#
# SCOPE: these variables are only used when running a service DIRECTLY on your machine
# (./gradlew bootRun). docker-compose.yml does NOT read this file - it sets every value
# inline as a literal, so `docker compose up` works without a .env at all.
#
# Each service reads the SAME three database variable names (DB_URL, DB_USERNAME,
# DB_PASSWORD), so one .env can only configure one service at a time. Uncomment the block
# for whichever service you are running, or export them per-shell.


# ---- Shared secret: user-service, order-service, api-gateway ----
# The HMAC-SHA256 signing key. All three MUST use the identical value or tokens minted by
# user-service will fail validation at the gateway and in order-service.
# Must be at least 32 bytes for HMAC-SHA256. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-random-32-byte-minimum-secret

# How long an issued token stays valid (user-service only). Defaults to 60 if unset.
JWT_EXPIRATION_MINUTES=60


# ---- Infrastructure ----
# Host values for running a service outside Docker against the Compose stack.
# Inside Docker these become kafka:9093 and redis, set by docker-compose.yml.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost


# ---- product-service (port 8080) ----
DB_URL=jdbc:postgresql://localhost:5432/productdb
DB_USERNAME=product_user
DB_PASSWORD=replace-with-your-local-password

# ---- user-service (port 8081) ----
# DB_URL=jdbc:postgresql://localhost:5434/userdb
# DB_USERNAME=user_service_user
# DB_PASSWORD=replace-with-your-local-password

# ---- order-service (port 8082) ----
# DB_URL=jdbc:postgresql://localhost:5435/orderdb
# DB_USERNAME=order_service_user
# DB_PASSWORD=replace-with-your-local-password
#
# Downstream services it calls over REST. Note the relaxed-binding spelling: dots become
# underscores and dashes are REMOVED, so services.product-service.base-url maps to
# SERVICES_PRODUCTSERVICE_BASEURL.
# SERVICES_PRODUCTSERVICE_BASEURL=http://localhost:8080
# SERVICES_USERSERVICE_BASEURL=http://localhost:8081

# ---- payment-service (port 8083) ----
# DB_URL=jdbc:postgresql://localhost:5436/paymentdb
# DB_USERNAME=payment_service_user
# DB_PASSWORD=replace-with-your-local-password


# ---- api-gateway (port 8090) ----
# Where the gateway forwards each route. Defaults to these localhost values if unset.
# SERVICES_USER_URL=http://localhost:8081
# SERVICES_PRODUCT_URL=http://localhost:8080
# SERVICES_ORDER_URL=http://localhost:8082
